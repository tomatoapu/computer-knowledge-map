<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>计算机工科核心知识地图</title>
<style>
:root{
  --bg:#f5f7fb;--panel:#fff;--ink:#1f2937;--muted:#667085;--line:#e5eaf2;
  --accent:#3659a8;--accent-soft:#eaf0ff;--side:#17233f;--side2:#223456;
  --green:#dff5e8;--yellow:#fff1c9;--purple:#eee7ff;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"Microsoft YaHei","PingFang SC",Arial,sans-serif;line-height:1.7}
button,input{font:inherit}
.topbar{position:sticky;top:0;z-index:5;background:rgba(255,255,255,.96);backdrop-filter:blur(8px);border-bottom:1px solid var(--line);padding:13px 22px;display:flex;gap:16px;align-items:center;justify-content:space-between}
.brand{font-size:17px;font-weight:800;letter-spacing:.2px}.brand span{color:var(--accent)}
.top-actions{display:flex;gap:8px;align-items:center}
.search{width:min(340px,42vw);border:1px solid var(--line);border-radius:10px;padding:9px 12px;background:#fafbfe;outline:none}
.search:focus{border-color:var(--accent);box-shadow:0 0 0 3px #3659a81a}
.btn{border:1px solid var(--line);background:white;border-radius:9px;padding:8px 12px;cursor:pointer;color:var(--ink)}
.btn:hover{background:var(--accent-soft);border-color:#cad6f8}
.layout{display:grid;grid-template-columns:300px minmax(0,1fr);min-height:calc(100vh - 60px)}
.sidebar{background:var(--side);color:#edf2ff;padding:20px 14px;position:sticky;top:59px;height:calc(100vh - 59px);overflow:auto}
.side-intro{padding:4px 12px 15px;border-bottom:1px solid #ffffff20;margin-bottom:12px}
.side-intro strong{display:block;font-size:16px}.side-intro small{color:#b9c6e4}
.tree{font-size:13px}.tree details{margin:3px 0}.tree summary{list-style:none;cursor:pointer;padding:7px 9px;border-radius:8px;display:flex;gap:7px;align-items:center;color:#e8eeff}
.tree summary::-webkit-details-marker{display:none}.tree summary::before{content:"▸";color:#a9bceb;display:inline-block;transition:transform .15s}
.tree details[open]>summary::before{transform:rotate(90deg)}
.tree summary:hover,.tree summary.active{background:var(--side2)}
.tree .children{padding-left:15px;border-left:1px solid #ffffff24;margin-left:15px}
.tree .leaf{display:block;width:100%;text-align:left;border:0;background:transparent;color:#cbd6ef;padding:6px 9px;border-radius:7px;cursor:pointer;font-size:12.5px}
.tree .leaf:hover,.tree .leaf.active{background:#3659a8;color:white}
.main{padding:28px clamp(18px,4vw,56px) 60px;max-width:1200px;width:100%;margin:0 auto}
.hero{background:linear-gradient(125deg,#1d3159,#3659a8);border-radius:20px;padding:30px clamp(20px,4vw,40px);color:white;box-shadow:0 14px 35px #1b31551a}
.eyebrow{font-size:12px;text-transform:uppercase;letter-spacing:1.8px;color:#c9d8ff;font-weight:700}
.hero h1{font-size:clamp(25px,4vw,38px);line-height:1.25;margin:8px 0 13px}
.hero p{max-width:780px;color:#e0e8ff;margin:0}
.hero-tags{display:flex;gap:8px;flex-wrap:wrap;margin-top:20px}
.tag{font-size:12px;border:1px solid #ffffff50;border-radius:99px;padding:4px 10px;color:#f2f5ff}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:18px 0 25px}
.stat{background:var(--panel);border:1px solid var(--line);border-radius:13px;padding:15px 17px}
.stat b{display:block;font-size:22px;color:var(--accent)}.stat span{font-size:12px;color:var(--muted)}
.content-card{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:clamp(20px,3vw,34px);margin-top:16px;box-shadow:0 4px 18px #182b4a06}
.kicker{font-size:12px;color:var(--accent);font-weight:800;letter-spacing:1px}
h2{font-size:27px;margin:5px 0 8px;line-height:1.35}h3{font-size:18px;margin:24px 0 8px}h4{margin:14px 0 5px}
.lead{font-size:16px;color:#46536a;margin:0 0 20px}
.note{border-left:4px solid #7192dc;background:#f2f6ff;padding:12px 15px;border-radius:0 9px 9px 0;margin:15px 0;color:#344665}
.warning{border-left-color:#d5a53c;background:#fff8e5}
.grid2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.mini{border:1px solid var(--line);border-radius:12px;padding:15px;background:#fcfdff}
.mini h3,.mini h4{margin-top:0}.mini p{margin:5px 0;color:#566176;font-size:14px}
ul,ol{padding-left:23px}li{margin:5px 0}
.path{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:15px 0}
.path span{background:var(--accent-soft);color:#2f4d91;border-radius:8px;padding:7px 10px;font-size:13px;font-weight:650}
.path i{color:#94a0b5;font-style:normal}
table{border-collapse:collapse;width:100%;font-size:14px;margin:12px 0}
th,td{border-bottom:1px solid var(--line);text-align:left;padding:10px 12px;vertical-align:top}
th{background:#f5f7fc;color:#34425b}
.pill{display:inline-block;background:#eef2f8;border-radius:6px;padding:2px 7px;font-size:12px;color:#485670;margin:2px}
.footer{font-size:12px;color:#7b8495;text-align:center;padding:28px 0}
.hide{display:none!important}
mark{background:#fff0b3;border-radius:3px;padding:0 2px}
@media(max-width:820px){
 .layout{grid-template-columns:1fr}.sidebar{position:relative;top:auto;height:auto;max-height:45vh}
 .topbar{padding:10px 12px;flex-wrap:wrap}.brand{font-size:15px}.search{width:48vw}
 .main{padding:18px 12px 40px}.stats{grid-template-columns:1fr}.grid2{grid-template-columns:1fr}
}
</style>
</head>
<body>
<header class="topbar">
  <div class="brand">计算机知识地图 <span>· Core CS</span></div>
  <div class="top-actions">
    <input id="search" class="search" type="search" placeholder="搜索知识点，例如：编译器、缓存、递归">
    <button class="btn" id="expandAll">展开目录</button>
    <button class="btn" id="collapseAll">收起目录</button>
  </div>
</header>
<div class="layout">
<aside class="sidebar">
  <div class="side-intro"><strong>知识目录</strong><small>点击目录项，在右侧阅读内容</small></div>
  <nav id="tree" class="tree" aria-label="知识目录"></nav>
</aside>
<main class="main" id="main">
  <section class="hero">
    <div class="eyebrow">A beginner-friendly learning map</div>
    <h1>计算机工科核心知识结构</h1>
    <p>把数学、硬件、算法、程序设计、系统软件、数据、网络、工程方法和人工智能放进同一张可扩展的地图。目录负责定位，正文负责理解；不要求一次学完，而是先建立整体结构，再逐层深入。</p>
    <div class="hero-tags"><span class="tag">可展开目录</span><span class="tag">知识点搜索</span><span class="tag">分层阅读</span><span class="tag">适合初学者</span></div>
  </section>
  <div class="stats">
    <div class="stat"><b>10 个</b><span>核心知识分支</span></div>
    <div class="stat"><b>4 个</b><span>理解知识的基本问题：对象、层级、角度、关系</span></div>
    <div class="stat"><b>5 阶段</b><span>从基础到方向深入的学习路线</span></div>
  </div>
  <section class="content-card">
    <div class="kicker">HOW TO USE</div>
    <h2>先学会“定位”，再学具体知识</h2>
    <p class="lead">碰到一个新概念时，不必急着背定义。先回答下面四个问题，通常就不会把不同层次的概念混在一起。</p>
    <div class="grid2">
      <div class="mini"><h3>1. 对象是什么？</h3><p>它是硬件、软件、算法、数据、系统，还是某个应用领域？</p></div>
      <div class="mini"><h3>2. 它处在哪个层级？</h3><p>它依赖什么、位于什么之上，又为哪些部分提供基础？</p></div>
      <div class="mini"><h3>3. 我从什么角度看它？</h3><p>可以看结构、功能、实现、运行过程、性能、安全性或设计方法。</p></div>
      <div class="mini"><h3>4. 它与什么有关？</h3><p>它可能由其他部分组成、调用其他部分、翻译其他表示，或与其他系统通信。</p></div>
    </div>
    <div class="note">重要说明：这是一套便于学习和查找的知识框架，不是唯一的官方分类。计算机知识相互交叉，同一个概念可以同时出现在不同地图中。</div>
    <h3>计算机核心知识总览</h3>
    <div class="path"><span>数学与理论</span><i>→</i><span>算法与数据结构</span><i>→</i><span>程序设计</span><i>→</i><span>系统实现</span><i>→</i><span>应用与研究</span></div>
    <p>这条路径是学习顺序的简化示意，不代表所有专业方向都必须严格按顺序学习。硬件、网络、数据库和人工智能等分支会在不同阶段交叉出现。</p>
  </section>
  <div class="footer">计算机工科核心知识地图 · 可作为个人学习目录持续扩展</div>
</main>
</div>
<script>
const sections = [
{ id:"math", title:"一、数学与计算理论", intro:"数学提供描述问题、分析算法、建立模型和证明结论的工具。不是每个方向都要同时精通全部数学，但离散数学与逻辑对计算机基础尤其重要。", children:[
["数学基础","微积分：变化率、极限、积分；线性代数：向量、矩阵、线性变换；概率统计：随机变量、分布、估计与检验；数值计算：用有限精度计算近似结果。"],
["离散数学与逻辑","集合、关系、函数、组合计数、图论、命题逻辑、谓词逻辑、证明方法。它们常用于算法、数据库、程序正确性和形式化方法。"],
["自动机与形式语言","正则表达式与有限自动机、上下文无关文法、下推自动机、图灵机。它们帮助解释语言识别、编译器和可计算性的边界。"],
["算法分析与计算复杂性","时间复杂度、空间复杂度、渐近符号、可计算性、P/NP 等复杂性概念。它们回答“能不能算”以及“算起来有多贵”。"]
]},
{ id:"hardware", title:"二、数字逻辑与计算机硬件", intro:"硬件分支关注信息如何被物理表示、数字电路如何工作，以及处理器怎样执行指令。它可以按器件—电路—逻辑—功能模块—系统逐步理解。", children:[
["数制与数据表示","二进制、十六进制、整数编码、补码、浮点数、字符编码、溢出与精度。程序中的数据最终都需要某种表示方式。"],
["数字逻辑","布尔代数、逻辑门、组合逻辑、时序逻辑、触发器、寄存器、计数器、有限状态机。组合逻辑主要由当前输入决定输出；时序逻辑还与状态有关。"],
["计算机组成","CPU、控制器、运算器/ALU、寄存器、主存、缓存、总线、输入输出设备。学习数据通路和控制器如何协作完成指令。"],
["指令集与处理器执行","指令集架构（ISA）、取指、译码、执行、访存、写回、异常、中断、流水线、并行处理。ISA 是软件与处理器之间的重要接口。"],
["存储层次","寄存器、缓存、主存、SSD/HDD 等在速度、容量、成本上的差异；局部性原理与缓存命中。"],
["FPGA 与硬件描述语言","FPGA 是可配置的数字硬件平台；Verilog/VHDL 用于描述电路行为或结构。它们与普通应用软件不是同一类对象。"],
["GPU、加速器与嵌入式硬件","GPU 擅长大量并行计算；AI 加速器针对特定计算优化；微控制器和嵌入式处理器常用于控制设备。"]
]},
{ id:"algo", title:"三、算法与数据结构", intro:"数据结构组织数据，算法规定解决问题的步骤。算法不是某一种编程语言的专属内容，同一个算法可以用 C、C++、Python 等语言实现。", children:[
["基础数据结构","数组、链表、栈、队列、哈希表、树、堆、图。理解每种结构如何存储数据，以及查询、插入、删除的代价。"],
["基本算法","排序、查找、递归、分治、贪心、动态规划、回溯、搜索、图遍历、最短路径、最小生成树。"],
["复杂度与正确性","时间复杂度、空间复杂度、边界情况、不变量、循环终止、正确性证明。程序能运行不等于算法一定正确或高效。"],
["进阶主题","随机算法、近似算法、在线算法、并行算法、优化算法。根据课程和研究方向逐步学习。"]
]},
{ id:"programming", title:"四、程序设计与编程语言", intro:"程序设计关注如何把问题表达成计算步骤；编程语言则规定程序可以使用哪些语法和语义。语言之间的差别不只是语法，也包括类型、内存和执行模型。", children:[
["编程基础","变量、类型、表达式、条件、循环、函数、数组、指针、结构体、文件、错误处理。建议用 C/C++ 建立底层理解，再按需求学习其他语言。"],
["程序组织","模块、接口、抽象、封装、复用、依赖管理。大型程序通常由多个相互协作的模块构成。"],
["语言机制","作用域、名字绑定、类型系统、静态/动态类型、值与引用、内存管理、异常、泛型、多态、并发机制。"],
["编程范式","过程式、面向对象、函数式、声明式、事件驱动等。它们是组织和表达程序的不同方式，不一定互斥。"],
["开发工具","编辑器、编译器、解释器、调试器、版本控制、构建工具、包管理器、测试框架。"]
]},
{ id:"systems", title:"五、操作系统、编译器与运行时", intro:"系统软件为程序提供运行环境或把程序转换为可执行形式。操作系统、编译器、解释器、虚拟机虽然有关联，但职责不同。", children:[
["操作系统","进程与线程、CPU 调度、虚拟内存、文件系统、设备管理、系统调用、同步互斥、死锁、权限。操作系统协调程序与硬件资源。"],
["编译器","词法分析、语法分析、语义分析、中间表示（IR）、优化、目标代码生成。编译器把一种程序表示转换成另一种表示。"],
["解释器与虚拟机","解释执行、字节码、虚拟机指令、运行时栈、对象管理、垃圾回收。解释器通常在运行时分析或执行程序表示；具体实现方式因语言而异。"],
["汇编、链接、加载与构建","汇编器把汇编指令转换成机器码；链接器组合目标文件和库；加载器把程序装入运行环境；构建系统组织整个生成流程。"],
["程序生命周期","源代码 → 构建/翻译 → 可执行文件或中间代码 → 加载 → 运行 → 测试与维护。老师所说的“源码层、构建层、运行层”可理解为观察这个过程的三个角度，但具体含义应以课堂定义为准。"],
["程序分析与优化","静态分析在不实际运行程序或不依赖某次运行结果的情况下分析代码性质；动态分析观察程序运行时行为；优化关注正确性约束下的效率提升。"]
]},
{ id:"data", title:"六、数据、文件与数据库", intro:"数据分支研究数据如何表示、保存、组织、查询、传输和分析。数据库是数据管理的重要领域，但并不是所有数据都必须存入数据库。", children:[
["数据表示与文件","文本、图像、音频、视频、二进制文件、目录结构、文件格式、序列化、持久化。"],
["数据库基础","关系模型、表、行、列、主键、外键、SQL、关系代数、函数依赖、规范化。"],
["数据库系统","索引、查询处理与优化、事务、并发控制、恢复、权限与备份。"],
["数据工程与分析","数据清洗、ETL、数据仓库、数据湖、分布式存储、统计分析与可视化。"]
]},
{ id:"network", title:"七、计算机网络与分布式系统", intro:"网络让独立设备交换信息；分布式系统进一步研究多个计算节点如何协作，并面对延迟、故障和数据一致性等问题。", children:[
["网络基础","分层模型、局域网、交换与路由、IP 地址、子网、DNS、TCP、UDP、HTTP/HTTPS。"],
["网络编程","客户端与服务器、Socket、请求与响应、超时、重试、并发连接、协议设计。"],
["分布式系统","节点协作、复制、一致性、容错、故障检测、分布式事务、消息队列。"],
["云计算与虚拟化","虚拟机、容器、云服务、弹性伸缩、部署、监控。虚拟化与容器技术帮助共享和管理计算资源。"]
]},
{ id:"engineering", title:"八、软件工程、测试与安全", intro:"软件工程关注如何可靠地构建和维护软件；测试、安全与质量不是最后才补上的装饰，而应贯穿需求、设计、编码和部署。", children:[
["软件开发过程","需求分析、系统设计、模块划分、编码规范、代码评审、版本控制、持续集成与部署、维护。"],
["测试与调试","单元测试、集成测试、系统测试、回归测试、断言、日志、断点、最小复现、边界测试。"],
["软件质量","正确性、可靠性、可用性、性能、可维护性、可扩展性、可移植性、能耗。不同目标之间可能存在权衡。"],
["计算机安全","身份认证、授权、密码学基础、漏洞、输入验证、内存安全、系统安全、隐私保护、威胁建模。"]
]},
{ id:"ai", title:"九、人工智能", intro:"人工智能不是孤立于计算机基础之外的分支。它大量依赖数学、算法、数据、硬件和软件系统，同时又形成了自己的模型、训练和评估方法。", children:[
["数学与算法基础","线性代数、概率统计、微积分、优化、搜索、规划、表示学习。"],
["机器学习","监督学习、无监督学习、特征、损失函数、训练/验证/测试、过拟合、泛化、模型评估。"],
["深度学习","神经网络、反向传播、卷积网络、循环网络、Transformer、训练技巧、GPU 计算。"],
["AI 子领域","计算机视觉、自然语言处理、语音、多模态、强化学习、机器人与智能决策。"],
["大模型与应用系统","预训练、微调、推理、检索增强生成、工具调用、智能体、评测、部署、成本与安全。"]
]},
{ id:"systemsmap", title:"十、计算机系统与应用场景", intro:"“计算机系统”通常指硬件、软件、数据和接口协同工作的整体，不是排在硬件下面的一层。不同系统类型也会重叠。", children:[
["通用计算系统","个人电脑、工作站、服务器。面向多种任务，通常运行通用操作系统和多类应用。"],
["嵌入式系统","汽车控制器、家电、无人机、工业设备等。通常与具体设备和实时控制任务紧密结合。"],
["高性能计算","超级计算机、GPU 集群、并行计算平台，面向科学计算、仿真和大规模模型训练等任务。"],
["移动与边缘计算","手机、可穿戴设备、边缘服务器。关注功耗、时延、连接性和本地处理能力。"],
["集成系统","机器人、自动驾驶、工业智能、数据库服务、AI 产品等，往往同时涉及硬件、软件、数据、网络与算法。"]
]},
{ id:"maps", title:"十一、用不同地图理解同一个概念", intro:"同一个概念可以同时属于多个视角。不要强行把所有知识塞进唯一的一棵树；先判断自己正在回答哪一种问题。", children:[
["对象地图：它是什么","硬件、软件、算法、数据、系统、网络、人工智能等。"],
["层级地图：它在哪里","从物理器件、数字电路、处理器与指令接口，到操作系统、运行环境和应用程序。不同模型的层级划分可能不同。"],
["结构地图：它由什么组成","例如软件系统可拆分成模块，模块可包含函数和数据；硬件系统可拆分成处理器、存储器和 I/O。"],
["生命周期地图：它如何产生和运行","需求 → 设计 → 编码 → 构建/翻译 → 加载 → 执行 → 测试 → 维护。"],
["关系地图：它如何连接","组成、依赖、调用、翻译、实现、通信、协作、竞争。"],
["角度地图：我在研究什么","结构、功能、实现、执行过程、性能、安全、可靠性、可维护性。"]
]},
{ id:"path", title:"十二、建议学习路线", intro:"你不需要同时学习所有分支。先打牢能互相支撑的基础，再沿着兴趣方向深入。对于想理解解释器、虚拟机和程序分析的学生，系统与语言实现是很自然的进阶路线。", children:[
["阶段一：编程与逻辑基础","二进制和编码；C/C++ 基础；函数、指针、结构体；调试；命题逻辑与集合。"],
["阶段二：计算机核心","数据结构与算法；离散数学；数字逻辑；计算机组成与指令执行。"],
["阶段三：系统基础","操作系统；计算机网络；数据库；汇编和机器指令的基本概念。"],
["阶段四：语言与系统实现","编译原理；解释器；虚拟机；运行时；程序分析；测试与优化。"],
["阶段五：选方向深入","例如 AI、编译器与静态分析、嵌入式、安全、数据库、网络或机器人。用项目把多个分支连接起来。"]
]},
{id:"threelevels", title:"十三、核心基础—核心框架—实验平台", intro:"这是一种组织学习内容的实用视角，不是唯一的学科分类标准。核心基础关注理论依据，核心框架关注专业原理与系统结构，实验平台关注实现、验证与测量。三者会反复互动，不是只能单向从上到下学习。", children:[
["核心基础：理论依据","回答“为什么成立、如何证明、怎样建模”。计算机方向常见内容包括离散数学、逻辑、算法与复杂度、概率统计、形式语言、计算模型等。不同研究方向依赖的数学并不相同。"],
["核心框架：专业原理","回答“如何组织成一个系统、系统怎样工作”。计算机方向包括数据结构与算法、计算机组成、操作系统、编译原理、程序语言、数据库、网络、人工智能等。它们不是单纯的应用层，而是各自的核心知识体系。"],
["实验平台：实现与验证","回答“怎样做出来、运行起来并验证”。例如 C/C++、调试器、编译器工具链、LLVM、仿真环境、测试框架、性能分析工具、FPGA 或单片机平台。平台是工具与实践载体，不等同于理论本身。"],
["三者如何循环","先用理论建立模型，再依据专业原理实现，用实验观察结果；如果结果与预期不符，就回到模型、实现或假设中排查。实践不必等到理论全部学完才开始。"],
["这套分类的边界","它适合规划学习，不是普适的严格分类。不同层次混合了理论、专业知识和工具三个维度；某些内容可能同时属于多个维度。例如 MATLAB 既是工具，也能用于数值计算实验；程序分析既有理论，也有工程工具。"],
["与你方向的对应关系","核心基础：离散数学、逻辑、算法、形式语言；核心框架：编译原理、解释器、类型系统、程序分析与优化；实验平台：C/C++、LLVM、调试器、测试与性能分析。建议理论和项目同步推进。"]
]},
{id:"personal", title:"十四、个人规划：学习、研究、就业", intro:"个人规划要把兴趣、能力、时间、学校资源、升学目标与就业出口放在一起评估。不要只根据学科在知识地图中的位置判断性价比，也不要因为学校层次就提前排除某个方向。", children:[
["先确定目标与约束","分别写清楚：考研目标（专业课与数学要求）、保研或竞赛需求、每周可投入时间、导师与实验室资源、毕业后偏研发还是偏应用。目标变化时，路线也可以调整。"],
["共同基础：不要过早押注","C/C++、数据结构与算法、离散数学、计算机组成、操作系统、计算机网络、数据库、软件工程与 Git。它们能支撑多种岗位和研究方向。"],
["方向 A：编译器与程序语言","学习编译原理、解释器、虚拟机、类型系统、静态分析和优化；做一个能运行的解释器或小型语言工具，再逐步加入类型检查、错误定位、数据流分析或优化。适合喜欢语言机制、底层原理和长期钻研的人。"],
["方向 B：系统软件与基础设施","学习 Linux、操作系统、并发、网络、性能分析、内存与调试；做系统工具、运行时组件、存储或性能优化项目。它和编译器有交集，也有较广泛的软件工程迁移能力。"],
["方向 C：AI 工程与应用","补足线性代数、概率统计、优化和机器学习基础，同时训练数据处理、模型评估、部署和工程能力。应用机会多，但竞争与技术迭代也快；不能只停留在调用模型 API。"],
["方向 D：软件开发与平台工程","强化工程实践、后端/客户端、数据库、测试、部署、协作与项目交付。通常更容易形成可展示的项目经历，也可作为底层方向的就业备选能力。"],
["阶段计划：未来 12 个月","第 1–3 个月：巩固 C/C++、数据结构、离散数学；第 4–6 个月：学计算机组成、操作系统和编译原理入门；第 7–9 个月：完成解释器或编译器小项目；第 10–12 个月：根据进展选一个研究问题，阅读论文、复现实验，并准备考研/实习所需能力。具体节奏应结合课程与考试安排调整。"],
["每学期复盘","每 8–12 周检查：学会了哪些可解释的概念？完成了什么可运行项目？是否有测试和文档？哪些课程成绩需要补强？是否仍喜欢这个方向？如果连续投入后发现不合适，可以转向相邻方向，而不是把前期学习视为浪费。"]
]}

];

const tree = document.getElementById('tree');
const main = document.getElementById('main');
const homeHTML = main.innerHTML;

function esc(s){return s.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function renderTree(){
  tree.innerHTML = sections.map((s,i)=>`<details open data-section="${s.id}">
    <summary data-target="${s.id}">${esc(s.title)}</summary>
    <div class="children">${s.children.map((c,j)=>`<button class="leaf" data-section="${s.id}" data-child="${j}">${esc(c[0])}</button>`).join('')}</div>
  </details>`).join('');
  tree.querySelectorAll('summary').forEach(el=>el.addEventListener('click',e=>{
    const target=el.dataset.target;
    if(el.parentElement.open){
      // allow normal collapse
    } else {
      // normal expand
    }
  }));
  tree.querySelectorAll('.leaf').forEach(el=>el.addEventListener('click',()=>{
    showSection(el.dataset.section, Number(el.dataset.child));
    tree.querySelectorAll('.leaf').forEach(x=>x.classList.toggle('active',x===el));
    tree.querySelectorAll('summary').forEach(x=>x.classList.toggle('active',x.dataset.target===el.dataset.section));
    if(window.innerWidth<820) document.getElementById('main').scrollIntoView({behavior:'smooth'});
  }));
  tree.querySelectorAll('summary').forEach(el=>el.addEventListener('dblclick',()=>showSection(el.dataset.target,null)));
}
function showSection(id, childIndex){
  const s=sections.find(x=>x.id===id); if(!s)return;
  const children=s.children.map((c,i)=>`<article class="mini" id="topic-${i}"><h3>${esc(c[0])}</h3><p>${esc(c[1])}</p></article>`).join('');
  main.innerHTML=`<section class="content-card" style="margin-top:0">
    <div class="kicker">KNOWLEDGE BRANCH</div><h2>${esc(s.title)}</h2><p class="lead">${esc(s.intro)}</p>
    ${childIndex!==null?`<div class="note">当前阅读：${esc(s.children[childIndex][0])}。可以继续阅读本分支的其他小节，逐步补全知识结构。</div>`:''}
    <div class="grid2">${children}</div>
    ${id==="personal"?`<div class="content-card" style="margin-top:18px">
      <div class="kicker">MY PLAN</div><h3>我的方向规划卡</h3>
      <p class="lead">先填写当前想法，不需要一次确定终身方向。点击“生成规划摘要”可得到一段可复制的自我规划。</p>
      <label for="goal"><strong>当前主要目标</strong></label>
      <select id="goal" style="display:block;width:100%;padding:10px;margin:6px 0 14px;border:1px solid var(--line);border-radius:8px">
        <option>考研：计算机软件理论 / 程序语言</option><option>就业：系统软件 / 基础设施</option><option>就业：通用软件开发</option><option>就业：AI 工程与应用</option><option>暂时探索，先打共同基础</option>
      </select>
      <label for="hours"><strong>每周可稳定投入的课外时间</strong></label>
      <select id="hours" style="display:block;width:100%;padding:10px;margin:6px 0 14px;border:1px solid var(--line);border-radius:8px">
        <option>3–5 小时</option><option>6–8 小时</option><option>9–12 小时</option><option>12 小时以上</option>
      </select>
      <label for="project"><strong>接下来最想完成的一个项目</strong></label>
      <input id="project" placeholder="例如：用 C++ 写一个支持变量和表达式的解释器" style="display:block;width:100%;padding:10px;margin:6px 0 14px;border:1px solid var(--line);border-radius:8px">
      <label for="review"><strong>本阶段的复盘日期</strong></label>
      <input id="review" type="date" style="display:block;padding:10px;margin:6px 0 14px;border:1px solid var(--line);border-radius:8px">
      <button class="btn" id="makePlan">生成规划摘要</button>
      <button class="btn" id="copyPlan">复制摘要</button>
      <pre id="planOutput" style="white-space:pre-wrap;background:#f5f7fc;padding:14px;border-radius:10px;min-height:45px;font-family:inherit"></pre>
    </div>`:""}
    <div class="note warning"><strong>学习提醒：</strong>目录中的内容是知识地图与入门解释，不是完整教材。遇到不熟悉的词，可以用顶部搜索定位，或先回到总览确认它属于哪个分支。</div>
    <button class="btn" id="homeBtn">返回总览</button>
  </section><div class="footer">计算机工科核心知识地图 · 当前分支：${esc(s.title)}</div>`;
  if(childIndex!==null){
    const el=document.getElementById('topic-'+childIndex);
    if(el){el.style.borderColor='#9eb4ed';el.style.background='#f4f7ff';el.scrollIntoView({block:'center',behavior:'smooth'});}
  }
  document.getElementById('homeBtn').addEventListener('click',()=>{
    main.innerHTML=homeHTML; attachHomeButton(); window.scrollTo({top:0,behavior:'smooth'});
  });
  if(id==="personal"){
    const make = () => {
      const goal=document.getElementById('goal').value;
      const hours=document.getElementById('hours').value;
      const project=document.getElementById('project').value.trim() || "完成一个可运行、可测试、有文档的小项目";
      const review=document.getElementById('review').value || "8–12 周后";
      document.getElementById('planOutput').textContent =
`我的阶段规划\n主要目标：${goal}\n每周投入：${hours}\n近期项目：${project}\n复盘时间：${review}\n\n执行原则：先打共同基础，再用项目验证兴趣；每周留出时间写代码、测试和记录问题；复盘时根据实际进展调整计划，不用一次决定终身方向。`;
    };
    document.getElementById('makePlan').addEventListener('click',make);
    document.getElementById('copyPlan').addEventListener('click',()=>{
      const text=document.getElementById('planOutput').textContent;
      if(text) navigator.clipboard?.writeText(text);
    });
  }
}
function attachHomeButton(){}
renderTree();

document.getElementById('expandAll').addEventListener('click',()=>tree.querySelectorAll('details').forEach(d=>d.open=true));
document.getElementById('collapseAll').addEventListener('click',()=>tree.querySelectorAll('details').forEach(d=>d.open=false));
document.getElementById('search').addEventListener('input',e=>{
  const q=e.target.value.trim().toLowerCase();
  tree.querySelectorAll('details').forEach(d=>{
    let found=false;
    const id=d.dataset.section; const s=sections.find(x=>x.id===id);
    const all=[s.title,s.intro,...s.children.flat()].join(' ').toLowerCase();
    found=!q||all.includes(q);
    d.classList.toggle('hide',!found);
    if(q&&found)d.open=true;
    d.querySelectorAll('.leaf').forEach((leaf)=>{
      const child=s.children[Number(leaf.dataset.child)];
      const matched=!q||child.join(' ').toLowerCase().includes(q)||s.title.toLowerCase().includes(q);
      leaf.classList.toggle('hide',!matched);
    });
  });
  if(q){
    const match=sections.find(s=>[s.title,s.intro,...s.children.flat()].join(' ').toLowerCase().includes(q));
    if(match) showSection(match.id,null);
  } else {
    main.innerHTML=homeHTML;
  }
});
</script>
</body>
</html>
